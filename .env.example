# Copy to .env (not committed): cp .env.example .env — then put your real backend URL here.
# Trailing slash is recommended for HttpClient BaseAddress.
BACKEND_BASE_URL=https://your-backend-host/

# Xray-core dns.servers (used for routing resolution). For Pi-hole per-user DNS matching,
# point these at Pi-hole reachable from the container (e.g. host gateway / host.docker.internal).
# Clients must also use this DNS through the VLESS tunnel (VLESS does not push dhcp-option DNS).
# DNS1=172.17.0.1
# DNS2=172.17.0.1

# Per-user DNS identity IPs (OpenVPN-style VirtualAddress for Pi-hole ClientIp → CommonName).
# Requires NET_ADMIN (ip aliases) and Pi-hole ClientSubnetPrefix matching the subnet (e.g. 10.80.0.).
# Set prefix BEFORE enabling identity (dashboard or PIHOLE_CLIENT_SUBNET_PREFIX) — sync hard-fails otherwise.
# Pi-hole must reply to 10.80.0.0/24 sources (same L2 / route). Only DNS :53 is tagged (not DoH).
# Shared Pi-hole + multiple Xray nodes: use non-overlapping XRAY_DNS_IDENTITY_SUBNET per node.
# Optional: XRAY_DNS_IDENTITY_SYNC_DEBOUNCE_MS=2000 (coalesce cert churn into one Xray restart).
# XRAY_DNS_IDENTITY_ENABLED=true
# XRAY_DNS_IDENTITY_SUBNET=10.80.0.0/24
# XRAY_DNS_IDENTITY_IFACE=eth0
# PIHOLE_CLIENT_SUBNET_PREFIX=10.80.0.

# When nginx stream proxies with `proxy_protocol on;`, set true so Xray sees the real client IP.
# XRAY_ACCEPT_PROXY_PROTOCOL=true

# Xray-core keeps a user "online" for as long as its inbound socket lives, and the VLESS inbound has no
# idle timeout, so a client that vanishes without FIN would hang in the dashboard forever. Keepalive on
# the inbound reaps such sockets (idle + interval * ~9 probes); 0 0 disables it.
# XRAY_TCP_KEEPALIVE_IDLE=60
# XRAY_TCP_KEEPALIVE_INTERVAL=15

# Backstop for online-map leftovers keepalive did not catch: a user is reported offline once neither
# lastSeen nor their traffic counters moved within this window. 0 disables the check.
# XRAY_ONLINE_SESSION_STALE_AFTER_SECONDS=600
